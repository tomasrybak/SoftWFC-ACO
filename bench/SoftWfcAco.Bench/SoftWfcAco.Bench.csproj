<Project Sdk="Microsoft.NET.Sdk">
  <!-- Seeded benchmark runner. Results must be reproducible from the seed list alone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SoftWfcAco\SoftWfcAco.csproj" />
    <ProjectReference Include="..\..\src\SoftWfcAco.Viz\SoftWfcAco.Viz.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tile sets next to the executable, so the default set works from any directory -->
    <None Include="..\..\data\tilesets\*.json" Link="tilesets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
